---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import SunLine from '../../components/SunLine.astro';
import { works, groups, numberWord, capWord } from '../../data/site';
const here = works.filter((w) => w.slug).length;
const away = works.filter((w) => !w.slug).length;
const lede = `${capWord(works.length)} rows. ${capWord(here)} open a page here, ${numberWord(away)} open where they live.`;
const rooms = groups.map((g) => ({ ...g, rows: works.filter((w) => w.group === g.key) }));
---
<Base title="Work" description={`${capWord(works.length)} pieces of work by Ravindra Sisodia, 2022 to 2026: Zop.Dev, YES Bank, CEAT, Tata Capital, three Mac apps, six web toys and three films.`} chapter="afternoon" state="0.7" current="/work/">
  <section class="page page--index" aria-labelledby="index-title">
    <div class="page__head">
      <p class="mono page__kicker">Index, 2022 to 2026 <SunLine /></p>
      <h1 id="index-title" class="title">All work, across rooms.</h1>
      <p class="lede">{lede}</p>
    </div>
    <ul class="index index--full" data-index>
      {rooms.map((g) => [
        <li class="index__group">
          <h2 class="index__group-title">{g.title}</h2>
          <p class="index__group-note">{g.note}</p>
          <span class="index__group-count mono">{String(g.rows.length).padStart(2, '0')}</span>
        </li>,
        ...g.rows.map((w) => (
        <li>
          <a class="index__row band" href={w.slug ? `/work/${w.slug}/` : w.href} data-preview={w.preview} data-cursor={w.slug ? 'Open' : 'Visit'} rel={w.slug ? undefined : 'noopener'}>
            <span class="index__n mono">{w.n}</span>
            <span class="index__title roll" data-text={w.title}><span>{w.title}</span></span>
            <span class="index__kind" data-cue={w.slug ? 'case' : 'live ↗'}>{w.kind}</span>
            <span class="index__year mono">{w.year}</span>
            <span class="index__ext mono" aria-hidden="true">{w.slug ? 'case' : 'live ↗'}</span>
            {w.preview ? <img class="index__thumb" src={w.preview} alt="" width="160" height="100" loading="lazy" /> : <span class="index__tile mono" aria-hidden="true">{w.n}</span>}
          </a>
        </li>
      ))])}
    </ul>
  </section>
  <Footer />
</Base>
