---
// The frame: name top-left, nav top-right, the one action bottom-right while the page is at its top.
// When the visitor scrolls back up, the top corners return on a band of the page's own colour.
import { site, hero } from '../data/site';
interface Props { current?: string }
const { current } = Astro.props;
---
<header class="frame" data-layer="content">
  <a class="frame__name frame__tl" href="/" aria-label={`${site.name}, home`}>
    <span class="frame__mark" aria-hidden="true"></span>
    <span class="roll" data-text={site.name}><span>{site.name}</span></span>
  </a>
  <nav class="frame__nav frame__tr" aria-label="Primary">
    {site.nav.map((n) => (
      <a class="band frame__link" href={n.href} aria-current={current === n.href ? 'page' : undefined}>
        <span class="roll" data-text={n.label}><span>{n.label}</span></span>
      </a>
    ))}
  </nav>
  <a class="frame__cta frame__br btn" href={`mailto:${site.email}`} data-fill>
    <span class="btn__fill" aria-hidden="true"></span>
    <span class="btn__label">{hero.cta}</span>
    <span class="btn__arrow" aria-hidden="true">→</span>
  </a>
</header>
