---
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import Loader from '../components/Loader.astro';
import Frame from '../components/Frame.astro';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  chapter?: string;   // pinned chapter for inner pages (noon, afternoon, night)
  state?: string;     // pinned sun position 0..1
  current?: string;   // nav href marked as current
}
const { title, description = site.description, image = '/og.png', chapter, state, current } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.titleRole}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
  sameAs: site.socials.map((s) => s.href),
};
---
<!doctype html>
<html lang="en" transition:animate="none" data-chapter={chapter ?? 'morning'} data-inner={chapter ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2E4CA6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href="/fonts/archivo-100_900-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      // Slow network or device: after 2.2 s without the script, show the page as it is (no sunrise, no reveals).
      setTimeout(function () { if (!document.documentElement.classList.contains('is-booted')) document.documentElement.classList.add('late-paint'); }, 2200);
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="gl" transition:persist="gl" aria-hidden="true"></div>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__panel"><span class="curtain__horizon"></span></div></div>
    <div id="cursor" transition:persist="cursor" aria-hidden="true"><span data-cursor-label></span></div>
    <Loader />
    <script is:inline>
      // The sunrise plays once per session, on the home page only. Everywhere else the page is simply there.
      (function () {
        var l = document.getElementById('loader');
        if (!l) return;
        var home = location.pathname === '/';
        var seen = false;
        try { seen = !!sessionStorage.getItem('sunrise'); if (home && !seen) sessionStorage.setItem('sunrise', '1'); } catch (e) {}
        if (!home || seen) l.remove();
      })();
    </script>
    <Frame current={current} />
    <main id="main" tabindex="-1" data-state={state} data-chapter={chapter}>
      <slot />
    </main>
    <div class="preview" aria-hidden="true"><img alt="" width="480" height="300" /></div>
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
    <script is:inline>
      // Vercel Web Analytics, only where it exists (never a 404 on a local build).
      if (/\.vercel\.app$/.test(location.hostname)) { const s = document.createElement('script'); s.defer = true; s.src = '/_vercel/insights/script.js'; document.body.appendChild(s); }
    </script>
  </body>
</html>
